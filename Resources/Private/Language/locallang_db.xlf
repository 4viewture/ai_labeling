<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" datatype="plaintext" original="EXT:ai_labeling/Resources/Private/Language/locallang_db.xlf" product-name="ai_labeling">
		<header/>
		<body>
			<trans-unit id="tab" resname="tab">
				<source>AI</source>
			</trans-unit>
			<trans-unit id="palette.involvement" resname="palette.involvement">
				<source>AI involvement</source>
			</trans-unit>
			<trans-unit id="palette.media" resname="palette.media">
				<source>Deepfake check (images, audio, video)</source>
			</trans-unit>
			<trans-unit id="palette.text" resname="palette.text">
				<source>Texts on matters of public interest</source>
			</trans-unit>
			<trans-unit id="palette.label" resname="palette.label">
				<source>Labelling</source>
			</trans-unit>
			<trans-unit id="palette.detection" resname="palette.detection">
				<source>Automatic detection</source>
			</trans-unit>
			<trans-unit id="involvement" resname="involvement">
				<source>Use of AI</source>
			</trans-unit>
			<trans-unit id="involvement.description" resname="involvement.description">
				<source>Technical adjustments such as colour correction, background, scaling, sharpening, compression or spell checking count as "AI-assisted" and do not require a label.</source>
			</trans-unit>
			<trans-unit id="involvement.0" resname="involvement.0">
				<source>No AI</source>
			</trans-unit>
			<trans-unit id="involvement.1" resname="involvement.1">
				<source>AI-assisted (technical adjustments only)</source>
			</trans-unit>
			<trans-unit id="involvement.2" resname="involvement.2">
				<source>Modified with AI (AI MODIFIED)</source>
			</trans-unit>
			<trans-unit id="involvement.3" resname="involvement.3">
				<source>Generated with AI (AI GENERATED)</source>
			</trans-unit>
			<trans-unit id="tool" resname="tool">
				<source>AI tool / model</source>
			</trans-unit>
			<trans-unit id="tool.description" resname="tool.description">
				<source>e.g. Midjourney v7, ChatGPT, Adobe Firefly – for traceability.</source>
			</trans-unit>
			<trans-unit id="real_reference" resname="real_reference">
				<source>Refers to real or plausible persons, places or events</source>
			</trans-unit>
			<trans-unit id="real_reference.description" resname="real_reference.description">
				<source>A well-known person is not necessary. Realistic-looking invented people or places also count.</source>
			</trans-unit>
			<trans-unit id="deceptive" resname="deceptive">
				<source>Could be mistaken for authentic (potential to deceive)</source>
			</trans-unit>
			<trans-unit id="deceptive.description" resname="deceptive.description">
				<source>Fantasy, comic or clearly stylised motifs, icons, infographics and abstract graphics usually have no potential to deceive.</source>
			</trans-unit>
			<trans-unit id="synthetic_person" resname="synthetic_person">
				<source>AI person appears as a real customer, employee or witness (testimonial)</source>
			</trans-unit>
			<trans-unit id="synthetic_person.description" resname="synthetic_person.description">
				<source>Counts as a deepfake and must be labelled. Additionally, there is a risk under competition law.</source>
			</trans-unit>
			<trans-unit id="product_altered" resname="product_altered">
				<source>AI changes the product itself or its use</source>
			</trans-unit>
			<trans-unit id="product_altered.description" resname="product_altered.description">
				<source>e.g. colour, material, size, accessories or usage situation. Misleading depictions may also be problematic under competition law even when labelled.</source>
			</trans-unit>
			<trans-unit id="public_interest" resname="public_interest">
				<source>Informs the public on matters of public interest</source>
			</trans-unit>
			<trans-unit id="public_interest.description" resname="public_interest.description">
				<source>e.g. public safety, health, environment, consumer protection, crisis communication, general political or economic questions. Purely promotional or company-related texts usually not – unless they look like independent reporting.</source>
			</trans-unit>
			<trans-unit id="human_review" resname="human_review">
				<source>Reviewed in substance by a human who bears editorial responsibility</source>
			</trans-unit>
			<trans-unit id="human_review.description" resname="human_review.description">
				<source>A cursory proofreading is not sufficient.</source>
			</trans-unit>
			<trans-unit id="reviewer" resname="reviewer">
				<source>Editorially responsible</source>
			</trans-unit>
			<trans-unit id="reviewer.description" resname="reviewer.description">
				<source>Person or organisation that reviewed the content and bears editorial responsibility.</source>
			</trans-unit>
			<trans-unit id="mode" resname="mode">
				<source>Label</source>
			</trans-unit>
			<trans-unit id="mode.description" resname="mode.description">
				<source>"Automatic" follows the assessment above (labels if required or recommended). In case of doubt: label. Voluntary labelling is always possible.</source>
			</trans-unit>
			<trans-unit id="mode.0" resname="mode.0">
				<source>Automatic (based on the assessment)</source>
			</trans-unit>
			<trans-unit id="mode.1" resname="mode.1">
				<source>Always label</source>
			</trans-unit>
			<trans-unit id="mode.2" resname="mode.2">
				<source>Do not label</source>
			</trans-unit>
			<trans-unit id="label_text" resname="label_text">
				<source>Label text</source>
			</trans-unit>
			<trans-unit id="label_text.description" resname="label_text.description">
				<source>Shown with the content in the frontend. Leave empty to use the default text.</source>
			</trans-unit>
			<trans-unit id="label_text.placeholder" resname="label_text.placeholder">
				<source>Default text, e.g. "This text was created with the help of AI."</source>
			</trans-unit>
			<trans-unit id="notes" resname="notes">
				<source>Internal notes</source>
			</trans-unit>
			<trans-unit id="detected" resname="detected">
				<source>Detected automatically from file metadata</source>
			</trans-unit>
			<trans-unit id="detection" resname="detection">
				<source>Detection evidence</source>
			</trans-unit>
			<trans-unit id="status" resname="status">
				<source>AI labelling status</source>
			</trans-unit>
			<trans-unit id="active" resname="active">
				<source>AI label active</source>
			</trans-unit>
			<trans-unit id="reasons" resname="reasons">
				<source>Reasons (computed)</source>
			</trans-unit>
			<trans-unit id="status.0" resname="status.0">
				<source>No label needed</source>
			</trans-unit>
			<trans-unit id="status.1" resname="status.1">
				<source>Label optional</source>
			</trans-unit>
			<trans-unit id="status.2" resname="status.2">
				<source>Label recommended</source>
			</trans-unit>
			<trans-unit id="status.3" resname="status.3">
				<source>Label required</source>
			</trans-unit>
		</body>
	</file>
</xliff>
