<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" target-language="de" datatype="plaintext" original="EXT:ai_labeling/Configuration/Sets/AiLabeling/labels.xlf" product-name="ai_labeling">
		<header/>
		<body>
			<trans-unit id="label" resname="label">
				<source>AI Labeling (EU AI Act Art. 50)</source>
				<target state="translated">KI-Kennzeichnung (KI-Verordnung Art. 50)</target>
			</trans-unit>
			<trans-unit id="categories.ailabeling" resname="categories.ailabeling">
				<source>AI labelling</source>
				<target state="translated">KI-Kennzeichnung</target>
			</trans-unit>
			<trans-unit id="categories.ailabeling.label" resname="categories.ailabeling.label">
				<source>Label</source>
				<target state="translated">Kennzeichnung</target>
			</trans-unit>
			<trans-unit id="categories.ailabeling.images" resname="categories.ailabeling.images">
				<source>Images</source>
				<target state="translated">Bilder</target>
			</trans-unit>
			<trans-unit id="categories.ailabeling.media" resname="categories.ailabeling.media">
				<source>Video and audio</source>
				<target state="translated">Video und Audio</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.css.include" resname="settings.plugin.tx_ailabeling.css.include">
				<source>Include CSS</source>
				<target state="translated">CSS einbinden</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.css.include" resname="settings.description.plugin.tx_ailabeling.css.include">
				<source>Load ai-label.css. Disable only if the site provides own styles for .ai-label.</source>
				<target state="translated">ai-label.css laden. Nur deaktivieren, wenn die Seite eigene Styles für .ai-label mitbringt.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.content.enable" resname="settings.plugin.tx_ailabeling.content.enable">
				<source>Label content elements</source>
				<target state="translated">Inhaltselemente kennzeichnen</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.content.enable" resname="settings.description.plugin.tx_ailabeling.content.enable">
				<source>Adds the label to labelled content elements via tt_content.stdWrap.postUserFunc.</source>
				<target state="translated">Gibt die Kennzeichnung an gekennzeichneten Inhaltselementen über tt_content.stdWrap.postUserFunc aus.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.text" resname="settings.plugin.tx_ailabeling.label.text">
				<source>Label text</source>
				<target state="translated">Kennzeichnungstext</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.label.text" resname="settings.description.plugin.tx_ailabeling.label.text">
				<source>&quot;Hidden&quot; keeps the text for screen readers only; the icon stays visible.</source>
				<target state="translated">„Ausgeblendet“ behält den Text nur für Screenreader; das Icon bleibt sichtbar.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.text.enum.visible" resname="settings.plugin.tx_ailabeling.label.text.enum.visible">
				<source>Visible</source>
				<target state="translated">Sichtbar</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.text.enum.hidden" resname="settings.plugin.tx_ailabeling.label.text.enum.hidden">
				<source>Hidden (screen readers only)</source>
				<target state="translated">Ausgeblendet (nur Screenreader)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.secondLayer" resname="settings.plugin.tx_ailabeling.label.secondLayer">
				<source>Second layer</source>
				<target state="translated">Zweite Ebene</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.label.secondLayer" resname="settings.description.plugin.tx_ailabeling.label.secondLayer">
				<source>Adds a button with an explanation next to the label (Popover API).</source>
				<target state="translated">Ergänzt eine Schaltfläche mit Erklärung neben der Kennzeichnung (Popover API).</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.symbol" resname="settings.plugin.tx_ailabeling.label.symbol">
				<source>Symbol (AI / KI)</source>
				<target state="translated">Symbol (AI / KI)</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.label.symbol" resname="settings.description.plugin.tx_ailabeling.label.symbol">
				<source>The Code of Practice uses the English acronym &quot;AI&quot;; the national acronym only where English is incompatible with national language law (Measure 1.1 a). &quot;Auto&quot; shows &quot;KI&quot; on German site languages.</source>
				<target state="translated">Der Verhaltenskodex verwendet das englische Kürzel „AI“; das nationale Kürzel nur, wenn Englisch mit nationalem Sprachrecht unvereinbar ist (Maßnahme 1.1 a). „Automatisch“ zeigt „KI“ bei deutscher Seitensprache.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.symbol.enum.ai" resname="settings.plugin.tx_ailabeling.label.symbol.enum.ai">
				<source>AI (EU icon)</source>
				<target state="translated">AI (EU-Icon)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.symbol.enum.ki" resname="settings.plugin.tx_ailabeling.label.symbol.enum.ki">
				<source>KI (German variant)</source>
				<target state="translated">KI (deutsche Variante)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.label.symbol.enum.auto" resname="settings.plugin.tx_ailabeling.label.symbol.enum.auto">
				<source>Automatic (KI on German site languages)</source>
				<target state="translated">Automatisch (KI bei deutscher Seitensprache)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.symbol" resname="settings.plugin.tx_ailabeling.images.symbol">
				<source>Burned-in symbol (AI / KI)</source>
				<target state="translated">Eingebranntes Symbol (AI / KI)</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.images.symbol" resname="settings.description.plugin.tx_ailabeling.images.symbol">
				<source>Processed images are shared by all languages, therefore no automatic choice. Clear processed files after changing.</source>
				<target state="translated">Verarbeitete Bilder gelten für alle Sprachen, daher keine automatische Wahl. Nach Änderung verarbeitete Dateien leeren.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.symbol.enum.ai" resname="settings.plugin.tx_ailabeling.images.symbol.enum.ai">
				<source>AI (EU icon)</source>
				<target state="translated">AI (EU-Icon)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.symbol.enum.ki" resname="settings.plugin.tx_ailabeling.images.symbol.enum.ki">
				<source>KI (German variant)</source>
				<target state="translated">KI (deutsche Variante)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.burnIn" resname="settings.plugin.tx_ailabeling.images.burnIn">
				<source>Burn symbol into images</source>
				<target state="translated">Symbol in Bilder einbrennen</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.images.burnIn" resname="settings.description.plugin.tx_ailabeling.images.burnIn">
				<source>Composites the EU &quot;AI&quot; symbol onto processed frontend images. Clear processed files after changing image settings.</source>
				<target state="translated">Fügt das EU-Symbol „AI“ in verarbeitete Frontend-Bilder ein. Nach Änderungen an den Bildeinstellungen die verarbeiteten Dateien leeren.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.position" resname="settings.plugin.tx_ailabeling.images.position">
				<source>Symbol position</source>
				<target state="translated">Position des Symbols</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.images.position" resname="settings.description.plugin.tx_ailabeling.images.position">
				<source>Default top right (Code of Practice, Sub-measure 1.2.2 a).</source>
				<target state="translated">Standard oben rechts (Verhaltenskodex, Teilmaßnahme 1.2.2 a).</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.position.enum.top-right" resname="settings.plugin.tx_ailabeling.images.position.enum.top-right">
				<source>Top right</source>
				<target state="translated">Oben rechts</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.position.enum.top-left" resname="settings.plugin.tx_ailabeling.images.position.enum.top-left">
				<source>Top left</source>
				<target state="translated">Oben links</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.position.enum.bottom-right" resname="settings.plugin.tx_ailabeling.images.position.enum.bottom-right">
				<source>Bottom right</source>
				<target state="translated">Unten rechts</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.position.enum.bottom-left" resname="settings.plugin.tx_ailabeling.images.position.enum.bottom-left">
				<source>Bottom left</source>
				<target state="translated">Unten links</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.sizePercent" resname="settings.plugin.tx_ailabeling.images.sizePercent">
				<source>Symbol size (% of shorter edge)</source>
				<target state="translated">Symbolgröße (% der kürzeren Kante)</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.images.sizePercent" resname="settings.description.plugin.tx_ailabeling.images.sizePercent">
				<source>Limited by minimum and maximum size.</source>
				<target state="translated">Begrenzt durch minimale und maximale Größe.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.minSize" resname="settings.plugin.tx_ailabeling.images.minSize">
				<source>Minimum symbol size (px)</source>
				<target state="translated">Minimale Symbolgröße (px)</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.images.minSize" resname="settings.description.plugin.tx_ailabeling.images.minSize">
				<source>Images smaller than about three times this size are not labelled by burn-in.</source>
				<target state="translated">Bilder, die kleiner als etwa das Dreifache sind, erhalten kein eingebranntes Symbol.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.maxSize" resname="settings.plugin.tx_ailabeling.images.maxSize">
				<source>Maximum symbol size (px)</source>
				<target state="translated">Maximale Symbolgröße (px)</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.images.altText" resname="settings.plugin.tx_ailabeling.images.altText">
				<source>Extend alternative text and caption</source>
				<target state="translated">Alternativtext und Bildunterschrift ergänzen</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.images.altText" resname="settings.description.plugin.tx_ailabeling.images.altText">
				<source>Appends the label text to non-empty alt attributes and adds the label to the figure caption.</source>
				<target state="translated">Hängt den Kennzeichnungstext an nicht leere alt-Attribute an und ergänzt die Kennzeichnung in der Bildunterschrift.</target>
			</trans-unit>
			<trans-unit id="settings.plugin.tx_ailabeling.media.overlay" resname="settings.plugin.tx_ailabeling.media.overlay">
				<source>Overlay on videos</source>
				<target state="translated">Overlay auf Videos</target>
			</trans-unit>
			<trans-unit id="settings.description.plugin.tx_ailabeling.media.overlay" resname="settings.description.plugin.tx_ailabeling.media.overlay">
				<source>Shows the label at the top of the player (never over the controls). Off: label below the player.</source>
				<target state="translated">Zeigt die Kennzeichnung oben im Player (nie über der Steuerleiste). Aus: Kennzeichnung unter dem Player.</target>
			</trans-unit>
		</body>
	</file>
</xliff>
