{
    "name": "4viewture/ai-labeling",
    "type": "typo3-cms-extension",
    "description": "Transparency fields for AI-generated or AI-modified files and content elements (Art. 50 EU AI Act), including an editor guide and automatic detection from file metadata (IPTC/XMP, C2PA, EXIF, PNG text chunks).",
    "license": "GPL-2.0-or-later",
    "keywords": ["TYPO3", "AI Act", "KI-Verordnung", "Kennzeichnung", "C2PA", "IPTC"],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "FourViewture\\AiLabeling\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FourViewture\\AiLabeling\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ai_labeling"
        }
    }
}
